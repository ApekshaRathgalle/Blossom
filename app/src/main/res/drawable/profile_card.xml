<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android">


    <!-- PURE WHITE CARD -->

    <solid
        android:color="#FFFFFF"/>


    <!-- Rounded corners -->

    <corners
        android:radius="28dp"/>


    <!-- Very soft border -->

    <stroke
        android:width="1dp"
        android:color="#F3DDE7"/>


    <!-- Inner spacing -->

    <padding

        android:left="16dp"

        android:right="16dp"

        android:top="12dp"

        android:bottom="12dp"/>


</shape>