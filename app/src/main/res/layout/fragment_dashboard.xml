<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/blossom_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/blossom_logo"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_notification"
                android:background="@drawable/icon_circle"/>

        </LinearLayout>

        <!-- GREETING -->
        <TextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Good Morning, Maya"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/blossom_text"
            android:fontFamily="serif"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Here's how your digital day is blooming"
            android:textSize="14sp"
            android:textColor="#8A6F7A"/>

        <!-- SCORE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="24dp"
            android:elevation="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/dashboard_card_pink">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIGITAL WELLNESS SCORE"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textColor="#8A6F7A"/>

            <TextView
                android:id="@+id/wellnessScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="72"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="@color/blossom_text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Moderate"
                android:textSize="13sp"
                android:textColor="#EC4C88"/>

        </LinearLayout>

        <!-- STATS -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="2"
            android:useDefaultMargins="false"
            android:alignmentMode="alignMargins">

            <TextView
                android:id="@+id/screenTime"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                android:padding="16dp"
                android:elevation="2dp"
                android:gravity="bottom"
                android:text="Screen Time\n0m"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/blossom_text"
                android:background="@drawable/dashboard_card_pink"/>

            <TextView
                android:id="@+id/appOpenings"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                android:padding="16dp"
                android:elevation="2dp"
                android:gravity="bottom"
                android:text="App Openings\n0"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/blossom_text"
                android:background="@drawable/dashboard_card_pink"/>

            <TextView
                android:id="@+id/lateNight"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:padding="16dp"
                android:elevation="2dp"
                android:gravity="bottom"
                android:text="Late Night\n0m"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/blossom_text"
                android:background="@drawable/dashboard_card_pink"/>

            <!-- BEDTIME DELAY CARD -->
            <LinearLayout
                android:id="@+id/bedtimeCard"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:padding="16dp"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bedtime_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bedtime Delay"
                    android:textSize="12sp"
                    android:textColor="#8A6F7A"/>

                <TextView
                    android:id="@+id/bedtimeDelay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0m"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/blossom_text"/>

            </LinearLayout>

        </GridLayout>

        <!-- MOST USED APPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="150dp"
            android:layout_marginTop="12dp"
            android:padding="18dp"
            android:elevation="2dp"
            android:orientation="vertical"
            android:background="@drawable/dashboard_card_pink">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Most Used Apps"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/blossom_text"/>

            <TextView
                android:id="@+id/mostUsedApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Loading..."
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:textColor="#8A6F7A"/>

        </LinearLayout>

        <!-- MESSAGE -->
        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:layout_marginTop="16dp"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:elevation="1dp"
            android:text="A gentle pause might help."
            android:textSize="15sp"
            android:textColor="#6D4C5B"
            android:background="@drawable/privacy_box"/>

    </LinearLayout>

</ScrollView>