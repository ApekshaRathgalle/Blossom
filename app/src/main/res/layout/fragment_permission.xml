<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:fillViewport="true"

    android:background="@color/blossom_background">


    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingBottom="40dp">



        <!-- Back Arrow -->

        <TextView

            android:id="@+id/backArrow"

            android:layout_width="40dp"

            android:layout_height="40dp"

            android:layout_marginStart="20dp"

            android:layout_marginTop="35dp"

            android:text="‹"

            android:textSize="40sp"

            android:textColor="#EC4C88"

            android:fontFamily="serif"/>



        <!-- Title -->

        <TextView

            android:layout_width="340dp"

            android:layout_height="wrap_content"

            android:layout_gravity="center"

            android:layout_marginTop="20dp"

            android:gravity="center"

            android:text="Let Blossom&#10;Understand Your&#10;Digital Habits"

            android:textSize="30sp"

            android:textStyle="bold"

            android:textColor="@color/blossom_text"

            android:fontFamily="serif"/>



        <!-- Subtitle -->

        <TextView

            android:layout_width="330dp"

            android:layout_height="wrap_content"

            android:layout_gravity="center"

            android:layout_marginTop="18dp"

            android:gravity="center"

            android:text="You stay in control of your data and&#10;permissions."

            android:textSize="16sp"

            android:textColor="#8A6F7A"

            android:fontFamily="serif"/>




        <!-- Usage Card -->

        <LinearLayout

            android:layout_width="340dp"

            android:layout_height="170dp"

            android:layout_gravity="center"

            android:layout_marginTop="35dp"

            android:orientation="vertical"

            android:padding="20dp"

            android:background="@drawable/permission_card">


            <!-- Icon Circle -->

            <ImageView

                android:layout_width="42dp"

                android:layout_height="42dp"

                android:padding="9dp"

                android:src="@drawable/ic_usage"

                android:background="@drawable/icon_circle"/>



            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:text="Usage Access"

                android:textSize="21sp"

                android:textStyle="bold"

                android:textColor="@color/blossom_text"

                android:fontFamily="serif"/>



            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:text="Allows Blossom to measure time spent&#10;and opening patterns for selected&#10;apps."

                android:textSize="15sp"

                android:textColor="#8A6F7A"

                android:fontFamily="serif"/>


        </LinearLayout>

        <!-- Notification Card -->

        <LinearLayout

            android:layout_width="340dp"

            android:layout_height="150dp"

            android:layout_gravity="center"

            android:layout_marginTop="18dp"

            android:orientation="vertical"

            android:padding="20dp"

            android:background="@drawable/permission_card">



            <ImageView

                android:layout_width="42dp"

                android:layout_height="42dp"

                android:padding="9dp"

                android:src="@drawable/ic_notification"

                android:background="@drawable/icon_circle"/>




            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"

                android:text="Notifications"

                android:textSize="21sp"

                android:textStyle="bold"

                android:textColor="@color/blossom_text"

                android:fontFamily="serif"/>



            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:text="Receive gentle reminders and&#10;wellness suggestions when needed."

                android:textSize="15sp"

                android:textColor="#8A6F7A"

                android:fontFamily="serif"/>


        </LinearLayout>



        <!-- Privacy Box -->

        <TextView

            android:layout_width="340dp"

            android:layout_height="105dp"

            android:layout_gravity="center"

            android:layout_marginTop="25dp"

            android:padding="20dp"

            android:text="🔒 Your privacy matters. Blossom&#10;does not read messages,&#10;passwords or social media&#10;content."

            android:textSize="14sp"

            android:textColor="#6D4C5B"

            android:background="@drawable/privacy_box"

            android:fontFamily="serif"/>




        <!-- Allow Button -->

        <TextView

            android:id="@+id/allowButton"

            android:layout_width="330dp"

            android:layout_height="55dp"

            android:layout_gravity="center"

            android:layout_marginTop="35dp"

            android:gravity="center"

            android:text="Allow &amp; Continue"

            android:textSize="16sp"

            android:textColor="#FFFFFF"

            android:fontFamily="serif"

            android:background="@drawable/button_permission"/>



        <!-- Setup Later -->

        <TextView

            android:id="@+id/setupLater"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_gravity="center"

            android:layout_marginTop="25dp"

            android:text="Set Up Later"

            android:textColor="#8A6F7A"

            android:textSize="15sp"

            android:fontFamily="serif"/>


    </LinearLayout>


</ScrollView>